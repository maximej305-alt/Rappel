<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Série » (2x2) : flamme, série actuelle, record. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="10dp"
    android:background="#D913151E">

    <TextView
        android:id="@+id/streak_flame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💤"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/streak_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textColor="#FFF2F3F8"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/streak_best"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★ 0"
        android:textColor="#FF9AA0B5"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
